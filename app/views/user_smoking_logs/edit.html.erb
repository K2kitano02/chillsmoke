<% content_for :title, "本数の修正 — ChillSmoke" %>

<div class="mx-auto flex min-h-[calc(100vh-9rem)] w-full max-w-md items-center py-4">
  <div class="w-full">
    <p class="text-xs font-bold uppercase tracking-wide text-amber-300">Smoking Log</p>
    <h1 class="mt-1 text-3xl font-black tracking-tight text-stone-100">本数の修正</h1>

    <div class="mt-6">
      <%= render "form" %>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      <%= link_to "カレンダーへ戻る", calendar_path(start_date: @log.smoked_on),
            class: "font-semibold text-amber-300 underline underline-offset-4" %>
      <%= link_to "ダッシュボードに戻る", dashboard_path,
            class: "font-semibold text-stone-400 underline underline-offset-4 hover:text-stone-200" %>
    </div>
  </div>
</div>
