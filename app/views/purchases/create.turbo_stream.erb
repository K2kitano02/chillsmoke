<%= turbo_stream.update "wishlist_detail_panel" do %>
  <%= render "user_wishlists/detail_panel",
        user_wishlist: @user_wishlist,
        balance: @balance %>
<% end %>

<%= turbo_stream.update "wishlist_purchase_history" do %>
  <%= render "user_wishlists/purchase_history",
        user_purchase_history: @user_purchase_history %>
<% end %>

<%= turbo_stream.update "header_metrics" do %>
  <%= render "shared/header_metrics",
        header_balance: @header_balance,
        header_streak_count: @header_streak_count %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
