<section class="mt-6 rounded-2xl border border-white/15 bg-[#171716]/95 p-4 shadow-2xl shadow-black/20 sm:p-6" aria-labelledby="pace-summary-heading">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-amber-300">Pace</p>
      <h2 id="pace-summary-heading" class="mt-1 text-xl font-black text-stone-100">直近7日間のペース</h2>
    </div>
    <p class="text-xs font-semibold text-stone-500">昨日までの7日間</p>
  </div>

  <% if @pace_data.complete? %>
    <div class="mt-5 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-amber-300/15 bg-amber-300/5 p-4">
        <p class="text-xs font-bold text-amber-200/80">1日平均</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-amber-300">
          約<%= @pace_data.average_smoking_count %><span class="ml-1 text-sm">本</span>
        </p>
      </div>
      <div class="rounded-xl border border-emerald-300/15 bg-emerald-300/5 p-4">
        <p class="text-xs font-bold text-emerald-200/80">1日平均節約額</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-emerald-300">
          <%= number_with_delimiter(@pace_data.average_saved_yen) %><span class="ml-1 text-sm">円</span>
        </p>
      </div>
      <div class="rounded-xl border border-sky-300/15 bg-sky-300/5 p-4">
        <p class="text-xs font-bold text-sky-200/80">30日間の節約ペース</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-sky-300">
          <%= number_with_delimiter(@pace_data.thirty_day_saved_yen) %><span class="ml-1 text-sm">円</span>
        </p>
      </div>
    </div>

    <% if @pace_data.target_difference.positive? %>
      <p class="mt-4 rounded-xl border border-emerald-300/15 bg-emerald-300/5 px-4 py-3 text-sm font-bold text-emerald-200">
        7日間では目標より<%= @pace_data.target_difference %>本少なく記録できました
      </p>
    <% elsif @pace_data.target_difference.negative? %>
      <p class="mt-4 rounded-xl border border-rose-300/15 bg-rose-300/5 px-4 py-3 text-sm font-bold text-rose-200">
        7日間では目標より<%= @pace_data.target_difference.abs %>本多い記録でした
      </p>
    <% else %>
      <p class="mt-4 rounded-xl border border-amber-300/15 bg-amber-300/5 px-4 py-3 text-sm font-bold text-amber-200">
        7日間では目標どおりの記録でした
      </p>
    <% end %>

    <p class="mt-3 text-xs leading-relaxed text-stone-500">
      現在のペースを30日続けた場合の目安です。将来の成果を保証するものではありません。
    </p>
  <% else %>
    <div class="mt-5 rounded-xl border border-dashed border-white/15 bg-black/10 px-5 py-7 text-center">
      <p class="text-sm font-black text-stone-200">ペースを確認するまであと<%= @pace_data.remaining_days %>日</p>
      <p class="mt-2 text-xs text-stone-500">
        昨日までの記録は<%= @pace_data.recorded_days %> / 7日です。7日分が揃うと平均と節約の目安を表示します。
      </p>
    </div>
  <% end %>
</section>
