<% content_for :title, "減煙レポート | ChillSmoke" %>

<div class="mx-auto w-full max-w-5xl">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-amber-300">Report</p>
      <h1 class="mt-1 text-3xl font-black tracking-tight text-stone-100">減煙レポート</h1>
      <p class="mt-2 text-sm text-stone-400">今日までの30日間を、喫煙本数と節約額の推移で振り返れます。</p>
    </div>
    <%= link_to "ダッシュボードへ戻る", dashboard_path,
          class: "self-start rounded-full bg-[#292823] px-4 py-2 text-sm font-semibold text-stone-100 ring-1 ring-white/10 hover:bg-[#343229] sm:self-auto" %>
  </div>

  <section
    class="mt-6 rounded-2xl border border-white/15 bg-[#171716]/95 p-4 shadow-2xl shadow-black/20 sm:p-6"
    data-controller="report-tabs"
    data-report-tabs-labels-value="<%= @trend_data.labels.to_json %>"
    data-report-tabs-smoking-counts-value="<%= @trend_data.smoking_counts.to_json %>"
    data-report-tabs-target-counts-value="<%= @trend_data.target_counts.to_json %>"
    data-report-tabs-saved-yen-value="<%= @trend_data.saved_yen.to_json %>">
    <div class="mb-5 grid grid-cols-2 gap-3">
      <div class="rounded-xl border border-white/10 bg-[#20201d] p-4">
        <p class="text-xs font-bold text-stone-400">30日間の記録</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-stone-100">
          <%= @trend_data.recorded_count %><span class="ml-1 text-sm text-stone-500">/ 30日</span>
        </p>
      </div>
      <div class="rounded-xl border border-emerald-300/15 bg-emerald-300/5 p-4">
        <p class="text-xs font-bold text-emerald-200/80">目標達成</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-emerald-300">
          <%= @trend_data.achieved_count %><span class="ml-1 text-sm text-stone-500">/ <%= @trend_data.recorded_count %>日</span>
        </p>
      </div>
    </div>

    <div
      class="grid grid-cols-2 gap-2 rounded-xl border border-white/5 bg-black/30 p-1.5"
      role="tablist"
      aria-label="表示するグラフ">
      <button
        id="smoking-tab"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="smoking-panel"
        tabindex="0"
        class="rounded-lg bg-amber-400 px-3 py-3 text-sm font-black text-stone-950 shadow-sm"
        data-report-tabs-target="tab"
        data-report-tabs-panel-param="smoking"
        data-action="click->report-tabs#select keydown->report-tabs#navigate">
        喫煙本数
      </button>
      <button
        id="savings-tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="savings-panel"
        tabindex="-1"
        class="rounded-lg px-3 py-3 text-sm font-bold text-stone-300 hover:bg-white/5"
        data-report-tabs-target="tab"
        data-report-tabs-panel-param="savings"
        data-action="click->report-tabs#select keydown->report-tabs#navigate">
        節約額
      </button>
    </div>

    <div
      id="smoking-panel"
      class="mt-6"
      role="tabpanel"
      aria-labelledby="smoking-tab"
      data-panel-name="smoking"
      data-report-tabs-target="panel">
      <div>
        <h2 class="text-lg font-bold text-stone-100">喫煙本数と目標の推移</h2>
      </div>

      <% if @trend_data.recorded? %>
        <section class="mt-5" aria-labelledby="recent-seven-days-heading">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 id="recent-seven-days-heading" class="text-sm font-bold text-stone-200">直近7日</h3>
            <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] font-medium text-stone-400" aria-label="日別カードの見方">
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>目標以内</span>
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-rose-400"></span>目標超過</span>
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full border border-stone-500"></span>未記録</span>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-7">
            <% @trend_data.recent_smoking_days.each do |day| %>
              <% recorded = !day[:smoking_count].nil? %>
              <% achieved = recorded && day[:smoking_count] <= day[:target_count] %>
              <% card_classes = if !recorded
                   "border-dashed border-stone-600/70 bg-black/10 text-stone-500"
                 elsif achieved
                   "border-emerald-400/35 bg-emerald-400/10 text-emerald-200"
                 else
                   "border-rose-400/35 bg-rose-400/10 text-rose-200"
                 end %>
              <div class="min-w-0 rounded-lg border px-2 py-3 text-center <%= card_classes %>">
                <p class="text-xs font-bold tabular-nums"><%= day[:date].strftime("%-m/%-d") %></p>
                <p class="mt-1 text-xl font-black tabular-nums">
                  <%= recorded ? day[:smoking_count] : "–" %><% if recorded %><span class="text-xs font-bold">本</span><% end %>
                </p>
                <p class="mt-1 truncate text-[10px] font-bold">
                  <%= recorded ? (achieved ? "達成" : "超過") : "未記録" %>
                </p>
              </div>
            <% end %>
          </div>
        </section>

        <section class="mt-6 rounded-xl border border-white/10 bg-[#101210] p-3 sm:p-5" aria-labelledby="smoking-chart-heading">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h3 id="smoking-chart-heading" class="text-sm font-bold text-stone-200">30日間の推移</h3>
              <p class="mt-1 text-xs text-stone-500"><%= @trend_data.dates.first.strftime("%-m月%-d日") %>〜<%= @trend_data.dates.last.strftime("%-m月%-d日") %></p>
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold text-stone-300" aria-label="グラフの見方">
              <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-4 bg-amber-400/70"></span>喫煙本数の推移</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>実績（目標以内）</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>実績（目標超過）</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-px w-4 border-t-2 border-dashed border-stone-400"></span>目標</span>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-stone-500">点がない日は未記録です。0本の記録はグラフ下端に実績として表示します。</p>

          <div class="relative mt-3 h-72 w-full sm:h-96">
            <canvas
              role="img"
              aria-label="直近30日間の喫煙本数と目標本数の折れ線グラフ"
              data-report-tabs-target="smokingCanvas">
              直近30日間の喫煙本数と目標本数を表示するグラフです。
            </canvas>
          </div>
        </section>
      <% else %>
        <%= render "empty_state" %>
      <% end %>
    </div>

    <div
      id="savings-panel"
      class="mt-6"
      role="tabpanel"
      aria-labelledby="savings-tab"
      data-panel-name="savings"
      data-report-tabs-target="panel"
      hidden>
      <div>
        <div>
          <h2 class="text-lg font-bold text-stone-100">日別節約額の推移</h2>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-emerald-300/15 bg-emerald-300/5 px-4 py-3">
            <p class="text-xs font-bold text-emerald-200/80">表示期間の確定節約額</p>
            <p class="mt-1 text-2xl font-black tabular-nums text-emerald-300"><%= number_with_delimiter(@trend_data.confirmed_saved_yen) %>円</p>
            <p class="mt-1 text-[11px] text-stone-500">昨日までの記録を合計</p>
          </div>
          <div class="rounded-xl border border-amber-400/20 bg-amber-400/5 px-4 py-3">
            <p class="text-xs font-bold text-amber-200/80">今日の節約見込み</p>
            <p class="mt-1 text-2xl font-black tabular-nums text-amber-300"><%= number_with_delimiter(@today_estimated_saved_yen) %>円</p>
            <p class="mt-1 text-[11px] text-stone-500">確定額のグラフには含めていません</p>
          </div>
        </div>
      </div>

      <% if @trend_data.confirmed_recorded? %>
        <div class="mt-6 rounded-xl border border-white/10 bg-[#101210] p-3 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h3 class="text-sm font-bold text-stone-200">30日間の日別節約額</h3>
              <p class="mt-1 text-xs text-stone-500"><%= @trend_data.dates.first.strftime("%-m月%-d日") %>〜<%= @trend_data.dates.last.strftime("%-m月%-d日") %></p>
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold text-stone-300" aria-label="グラフの見方">
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-400"></span>節約できた日</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-3 bg-rose-400"></span>0円の記録</span>
            </div>
          </div>
          <p class="mt-3 text-xs text-stone-500">棒がない日は未記録です。0円として記録された日は赤い細線で表示します。</p>

          <div class="relative mt-3 h-72 w-full sm:h-96">
            <canvas
              role="img"
              aria-label="直近30日間の日別節約額の棒グラフ"
              data-report-tabs-target="savingsCanvas">
              直近30日間の日別節約額を表示するグラフです。
            </canvas>
          </div>
        </div>
      <% elsif @trend_data.recorded? %>
        <div class="mt-6 rounded-xl border border-dashed border-white/15 bg-black/10 px-5 py-10 text-center">
          <p class="font-bold text-stone-200">昨日までの確定記録はまだありません</p>
          <p class="mt-2 text-sm text-stone-500">今日分は上の「今日の節約見込み」に表示しています。確定後、日別節約額のグラフへ反映されます。</p>
        </div>
      <% else %>
        <%= render "empty_state" %>
      <% end %>
    </div>
  </section>
</div>
